{
  "name": "primblocks",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "description": "Snap-together block editor that compiles to LSL for Second Life",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/lsl/assemble.test.ts src/lib/lsl/types.test.ts src/lib/lsl/notecard.test.ts src/lib/lsl/cables.test.ts src/lib/lsl/tutorials.test.ts src/lib/update.test.ts",
    "smoke:examples": "npx --yes vite-node scripts/smoke-examples.ts",
    "catalog": "node --experimental-strip-types scripts/write-catalog.ts",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "blockly": "^13.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  }
}
